{
  "name": "Nexus-1MD",
  "description": "A lightweight, customizable, multi-functional WhatsApp automation bot built with Baileys.",
  "repository": "https://github.com/devwhitewizard/nexus-v1md",
  "logo": "https://raw.githubusercontent.com/devwhitewizard/nexus-v1md/main/assets/nexus-logo.svg",
 "stack": "heroku-24",
  "addons": [
    {
      "plan": "heroku-postgresql"
    }
  ],
  "scripts": {
    "start": "node index.js"
  },
  "env": {
    "SESSION_ID": {
      "description": "Your unique bot session ID string generated on login (starts with NEXUS~).",
      "value": "",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/heroku/heroku-buildpack-activestorage-preview"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ]
}